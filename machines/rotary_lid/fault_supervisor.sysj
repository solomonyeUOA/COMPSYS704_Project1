// M3 IP fault supervisor. It never drives transfer, rotary or lid actuators.

FaultSupervisor(
    input String signal TRANSFER_FAULT_EVENT;
    input String signal TRANSFER_RECOVERY_ACK;
    input String signal TRANSFER_RECOVERY_RESULT;
    input String signal FT_SAFE_STOP_ACK;
    input String signal FT_RESUME_DECISION;
    input String signal M3_SYSTEM_RESET;
    input String signal WATCHDOG_M1_HEARTBEAT;
    input String signal WATCHDOG_M2_HEARTBEAT;
    input String signal WATCHDOG_M4_HEARTBEAT;
    input String signal WATCHDOG_POS_HEARTBEAT;

    output String signal TRANSFER_RECOVERY_REQUEST;
    output String signal FT_FAULT_ALERT;
    output String signal FT_SAFE_STOP_REQUEST;
    output String signal FT_RECOVERY_READY;
    output String signal FT_RECOVERY_FAILED;
    output String signal M3_SYSTEM_RESET_ACK;
    output String signal SYSTEM_RESET_REQUEST;
    output String signal TEST_TRANSFER_FAULT;
    output String signal TEST_TRANSFER_RECOVERY;
    output String signal FT_TEST_CONTROL;
)
->{
    FaultManagementGUI.start();
    System.out.println("M3 FaultSupervisorCD started on V2.1 boundary");

    {loop {
        present(M3_SYSTEM_RESET) {
            if (M3SystemResetStateV1.accept(#M3_SYSTEM_RESET)) {
                SystemWatchdogV1.onSystemResetAccepted(#M3_SYSTEM_RESET);
            }
        }
        pause;
    }}
    ||
    {loop {
        String testControl = FaultTestControlStateV2_1.nextRequest();
        if (testControl != null) {
            emit FT_TEST_CONTROL(testControl);
        }
        String transferRecovery =
            FaultTestControlStateV2_1.nextTransferRequest();
        if (transferRecovery != null) {
            emit TEST_TRANSFER_RECOVERY(transferRecovery);
        }
        pause;
    }}
    ||
    {loop {
        if (!M3SystemResetStateV1.isQuarantined()) {
            String testFault = FaultInjectionStateV2_1.nextTransferRequest();
            if (testFault != null) {
                emit TEST_TRANSFER_FAULT(testFault);
            }
        }
        pause;
    }}
    ||
    {loop {
        String resetAck = M3SystemResetStateV1.takeAck();
        if (resetAck != null) {
            emit M3_SYSTEM_RESET_ACK(resetAck);
        }
        pause;
    }}
    ||
    {loop {
        present(WATCHDOG_M1_HEARTBEAT) {
            FaultMonitoringStateV2_1.externalHeartbeat(
                FaultMonitoringStateV2_1.M1_LINK,
                #WATCHDOG_M1_HEARTBEAT
            );
        }
        present(WATCHDOG_M2_HEARTBEAT) {
            FaultMonitoringStateV2_1.externalHeartbeat(
                FaultMonitoringStateV2_1.M2_LINK,
                #WATCHDOG_M2_HEARTBEAT
            );
        }
        present(WATCHDOG_M4_HEARTBEAT) {
            FaultMonitoringStateV2_1.externalHeartbeat(
                FaultMonitoringStateV2_1.M4_LINK,
                #WATCHDOG_M4_HEARTBEAT
            );
        }
        present(WATCHDOG_POS_HEARTBEAT) {
            FaultMonitoringStateV2_1.externalHeartbeat(
                FaultMonitoringStateV2_1.POS_LINK,
                #WATCHDOG_POS_HEARTBEAT
            );
        }
        pause;
    }}
    ||
    {loop {
        String resetRequest = SystemWatchdogV1.nextSystemResetRequest();
        if (resetRequest != null) {
            emit SYSTEM_RESET_REQUEST(resetRequest);
        }
        pause;
    }}
    ||
    {loop {
        if (!M3SystemResetStateV1.isQuarantined()) {
        present(TRANSFER_FAULT_EVENT) {
            FaultSupervisorStateV2_1.onTransferFault(
                #TRANSFER_FAULT_EVENT
            );
        }
        present(TRANSFER_RECOVERY_ACK) {
            FaultSupervisorStateV2_1.onRecoveryAck(
                #TRANSFER_RECOVERY_ACK
            );
        }
        present(TRANSFER_RECOVERY_RESULT) {
            FaultSupervisorStateV2_1.onRecoveryResult(
                #TRANSFER_RECOVERY_RESULT
            );
        }

        // M1 messages are correlated to the active event and state version.
        present(FT_SAFE_STOP_ACK) {
            FaultSupervisorStateV2_1.onSafeStopAck(#FT_SAFE_STOP_ACK);
        }
        present(FT_RESUME_DECISION) {
            FaultSupervisorStateV2_1.onResumeDecision(
                #FT_RESUME_DECISION
            );
        }
        }

        pause;
    }}
    ||
    {loop {
        if (!M3SystemResetStateV1.isQuarantined()) {
        String request = FaultSupervisorStateV2_1.takeRecoveryRequest();
        if (request != null) {
            emit TRANSFER_RECOVERY_REQUEST(request);
        }
        }
        pause;
    }}
    ||
    {loop {
        if (!M3SystemResetStateV1.isQuarantined()) {
        String alert = FaultSupervisorStateV2_1.takeFaultAlert();
        if (alert != null) {
            emit FT_FAULT_ALERT(alert);
        }
        }
        pause;
    }}
    ||
    {loop {
        if (!M3SystemResetStateV1.isQuarantined()) {
        String safeStop = FaultSupervisorStateV2_1.takeSafeStopRequest();
        if (safeStop != null) {
            emit FT_SAFE_STOP_REQUEST(safeStop);
        }
        }
        pause;
    }}
    ||
    {loop {
        if (!M3SystemResetStateV1.isQuarantined()) {
        String ready = FaultSupervisorStateV2_1.takeRecoveryReady();
        if (ready != null) {
            emit FT_RECOVERY_READY(ready);
        }
        }
        pause;
    }}
    ||
    {loop {
        if (!M3SystemResetStateV1.isQuarantined()) {
        String failed = FaultSupervisorStateV2_1.takeRecoveryFailed();
        if (failed != null) {
            emit FT_RECOVERY_FAILED(failed);
        }
        }
        pause;
    }}
}
