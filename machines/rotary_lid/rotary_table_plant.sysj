// Six-position rotary Plant with P1/P2/P3/P4/P6 bottle correlation.

RotaryTablePlant(
    input Integer signal ROTARY_TABLE_TRIGGER;
    input Integer signal ROTATION_DONE;
    input String signal ROTARY_CONTEXT_TO_PLANT;
    input String signal LOAD_BOTTLE;
    input String signal MARK_FILLED;
    input String signal LID_CYCLE_DONE;
    input String signal MARK_CAPPED;
    input String signal MARK_LABELLED;
    input String signal P6_CLEAR;
    input signal INJECT_ALIGNMENT_FAULT;
    input signal CLEAR_ALIGNMENT_FAULT;

    output signal ROTATION_READY;
    output signal TABLE_ALIGNED_WITH_SENSOR;
    output String signal BOTTLE_AT_LID_POSITION;
    output signal LID_POSITION_CLEAR;
    output String signal BOTTLE_AT_FILL;
    output String signal BOTTLE_AT_CAP;
    output String signal BOTTLE_AT_LABEL;
)
->{
    Member3Visualisation.start();
    System.out.println("Member 3 RotaryTablePlantCD started");

    {loop {present(LOAD_BOTTLE) {
        if (!Member3PlantStateV1.loadBottle(#LOAD_BOTTLE)) {
            System.out.println("M3 rejected LOAD_BOTTLE=" + #LOAD_BOTTLE);
        }
    } pause;}}
    ||
    {loop {present(ROTARY_CONTEXT_TO_PLANT) {
        if (!Member3PlantStateV1.registerBottleContext(
            #ROTARY_CONTEXT_TO_PLANT
        )) {
            System.out.println("M3 rejected forwarded bottle context");
        }
        else {
            System.out.println("M3 Plant registered bottle context");
        }
    } pause;}}
    ||
    {loop {present(MARK_FILLED) {
        if (!Member3PlantStateV1.markFilled(#MARK_FILLED)) {
            System.out.println("M3 rejected MARK_FILLED=" + #MARK_FILLED);
        }
    } pause;}}
    ||
    {loop {present(LID_CYCLE_DONE) {
        if (!Member3PlantStateV1.markLidPlaced(#LID_CYCLE_DONE)) {
            System.out.println("M3 rejected LID_CYCLE_DONE=" +
                #LID_CYCLE_DONE);
        }
    } pause;}}
    ||
    {loop {present(MARK_CAPPED) {
        if (!Member3PlantStateV1.markCapped(#MARK_CAPPED)) {
            System.out.println("M3 rejected MARK_CAPPED=" + #MARK_CAPPED);
        }
    } pause;}}
    ||
    {loop {present(MARK_LABELLED) {
        if (!Member3PlantStateV1.markLabelled(#MARK_LABELLED)) {
            System.out.println("M3 rejected MARK_LABELLED=" +
                #MARK_LABELLED);
        }
    } pause;}}
    ||
    {loop {present(P6_CLEAR) {
        if (!Member3PlantStateV1.clearP6(#P6_CLEAR)) {
            System.out.println("M3 rejected P6_CLEAR=" + #P6_CLEAR);
        }
    } pause;}}
    ||
    {loop {present(INJECT_ALIGNMENT_FAULT) {
        Member3PlantStateV1.setAlignmentFault(true);
    } pause;}}
    ||
    {loop {present(CLEAR_ALIGNMENT_FAULT) {
        Member3PlantStateV1.setAlignmentFault(false);
    } pause;}}
    ||
    {loop {
        present(ROTARY_TABLE_TRIGGER) {
            Member3PlantStateV1.setRotaryMotor(
                true,
                #ROTARY_TABLE_TRIGGER
            );
        }
        else {
            Member3PlantStateV1.setRotaryMotor(false, 0);
        }
        present(ROTATION_DONE) {
            if (!Member3PlantStateV1.commitRotation(#ROTATION_DONE)) {
                System.out.println("M3 rejected ROTATION_DONE cycle=" +
                    #ROTATION_DONE);
            }
        }
        Member3PlantStateV1.updateRotary();
        pause;
    }}
    ||
    {loop {
        if (Member3PlantStateV1.canRotate()) {
            emit ROTATION_READY;
        }
        if (Member3PlantStateV1.isTableAligned()) {
            emit TABLE_ALIGNED_WITH_SENSOR;
        }

        String lidBottleId =
            Member3PlantStateV1.getBottleWaitingForLidId();
        if (lidBottleId != null) {
            emit BOTTLE_AT_LID_POSITION(lidBottleId);
        }
        else {
            emit LID_POSITION_CLEAR;
        }

        String fillOffer = Member3PlantStateV1.takeFillOffer();
        if (fillOffer != null) {
            emit BOTTLE_AT_FILL(fillOffer);
            System.out.println("M3 offered P2 bottle to filler");
        }
        String capOffer = Member3PlantStateV1.takeCapOffer();
        if (capOffer != null) {
            emit BOTTLE_AT_CAP(capOffer);
            System.out.println("M3 offered P4 bottle to capper");
        }
        String labelOffer = Member3PlantStateV1.takeLabelOffer();
        if (labelOffer != null) {
            emit BOTTLE_AT_LABEL(labelOffer);
            System.out.println("M3 offered P6 bottle to labeller");
        }
        pause;
    }}
}
