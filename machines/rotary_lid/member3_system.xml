<?xml version="1.0" encoding="UTF-8"?>
<!-- Canonical Member 3 runtime: both Controllers and both Plant models. -->
<System xmlns="http://systemjtechnology.com">
    <SubSystem Name="MEMBER3_SS" Local="true">
        <ClockDomain Name="TransportControllerCD" Class="TransportController">
            <iSignal Name="TRANSPORT_STATUS_REQUEST" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11003" />
            <iSignal Name="ROTATE_REQUEST" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11003" />
            <iSignal Name="TABLE_ALIGNED_WITH_SENSOR" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11003" />
            <iSignal Name="CAP_ON_BOTTLE_AT_POS1" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11003" />
            <iSignal Name="ROTARY_FAULT_RESET" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11003" />
            <oSignal Name="TRANSPORT_STATUS" To="CoordinatorCD.TRANSPORT_STATUS" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11001" />
            <oSignal Name="ROTARY_TABLE_TRIGGER" To="RotaryTablePlantCD.ROTARY_TABLE_TRIGGER" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12003" />
            <oSignal Name="ROTATION_DONE" To="RotaryTablePlantCD.ROTATION_DONE" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12003" />
        </ClockDomain>

        <ClockDomain Name="RotaryTablePlantCD" Class="RotaryTablePlant">
            <iSignal Name="ROTARY_TABLE_TRIGGER" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12003" />
            <iSignal Name="LOAD_BOTTLE" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12003" />
            <iSignal Name="MARK_FILLED" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12003" />
            <iSignal Name="MARK_LID_PLACED" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12003" />
            <iSignal Name="MARK_CAPPED" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12003" />
            <iSignal Name="REMOVE_BOTTLE" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12003" />
            <iSignal Name="INJECT_ALIGNMENT_FAULT" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12003" />
            <iSignal Name="CLEAR_ALIGNMENT_FAULT" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12003" />
            <iSignal Name="ROTATION_DONE" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12003" />
            <oSignal Name="TABLE_ALIGNED_WITH_SENSOR" To="TransportControllerCD.TABLE_ALIGNED_WITH_SENSOR" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11003" />
            <oSignal Name="CAP_ON_BOTTLE_AT_POS1" To="TransportControllerCD.CAP_ON_BOTTLE_AT_POS1" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11003" />
            <oSignal Name="BOTTLE_AT_LID_POSITION" To="LidLoaderControllerCD.BOTTLE_AT_LID_POSITION" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11006" />
            <oSignal Name="LID_POSITION_CLEAR" To="LidLoaderControllerCD.LID_POSITION_CLEAR" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11006" />
        </ClockDomain>

        <ClockDomain Name="LidLoaderControllerCD" Class="LidLoaderController">
            <iSignal Name="LID_STATUS_REQUEST" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11006" />
            <iSignal Name="BOTTLE_AT_LID_POSITION" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11006" />
            <iSignal Name="LID_POSITION_CLEAR" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11006" />
            <iSignal Name="LID_AVAILABLE" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11006" />
            <iSignal Name="LID_MAGAZINE_EMPTY" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11006" />
            <iSignal Name="LID_PICKED" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11006" />
            <iSignal Name="LID_PLACED_SENSOR" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11006" />
            <iSignal Name="LID_FAULT_RESET" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11006" />
            <oSignal Name="LID_STATUS" To="CoordinatorCD.LID_STATUS" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11001" />
            <oSignal Name="PICK_LID_TRIGGER" To="LidLoaderPlantCD.PICK_LID_TRIGGER" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12006" />
            <oSignal Name="PLACE_LID_TRIGGER" To="LidLoaderPlantCD.PLACE_LID_TRIGGER" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12006" />
            <oSignal Name="LID_ABORT" To="LidLoaderPlantCD.LID_ABORT" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12006" />
            <oSignal Name="LID_CYCLE_DONE" To="RotaryTablePlantCD.MARK_LID_PLACED" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12003" />
        </ClockDomain>

        <ClockDomain Name="LidLoaderPlantCD" Class="LidLoaderPlant">
            <iSignal Name="PICK_LID_TRIGGER" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12006" />
            <iSignal Name="PLACE_LID_TRIGGER" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12006" />
            <iSignal Name="LID_ABORT" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12006" />
            <iSignal Name="REFILL_LIDS" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12006" />
            <iSignal Name="INJECT_PICK_FAULT" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12006" />
            <iSignal Name="CLEAR_PICK_FAULT" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12006" />
            <iSignal Name="INJECT_PLACE_FAULT" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12006" />
            <iSignal Name="CLEAR_PLACE_FAULT" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12006" />
            <oSignal Name="LID_AVAILABLE" To="LidLoaderControllerCD.LID_AVAILABLE" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11006" />
            <oSignal Name="LID_MAGAZINE_EMPTY" To="LidLoaderControllerCD.LID_MAGAZINE_EMPTY" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11006" />
            <oSignal Name="LID_PICKED" To="LidLoaderControllerCD.LID_PICKED" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11006" />
            <oSignal Name="LID_PLACED_SENSOR" To="LidLoaderControllerCD.LID_PLACED_SENSOR" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11006" />
        </ClockDomain>
    </SubSystem>
</System>
