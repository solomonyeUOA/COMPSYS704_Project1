// Validates one S/L context per bottleId and distributes unchanged profiles.

BottleContextRegistry(
    input String signal BOTTLE_RECOGNISED;
    input String signal M4_SYSTEM_RESET;

    output String signal ROTARY_BOTTLE_CONTEXT;
    output String signal LOAD_PROFILE;
    output String signal UNLOAD_PROFILE;
    output String signal M4_SYSTEM_RESET_ACK;
    output String signal M4_WORKPIECE_OBSERVATION;
)
->{
    System.out.println("M4 BottleContextRegistryCD started");

    {loop {
        present(M4_SYSTEM_RESET) {
            M4SystemResetStateV1.request(#M4_SYSTEM_RESET);
        }
        M4SystemResetStateV1.tick();
        String resetAck = M4SystemResetStateV1.takeAck();
        if (resetAck != null) {
            emit M4_SYSTEM_RESET_ACK(resetAck);
        }
        present(BOTTLE_RECOGNISED) {
            if (!Member4MachineStateV1.acceptRecognition(
                #BOTTLE_RECOGNISED
            )) {
                System.out.println(
                    "M4 Registry rejected or de-duplicated recognition"
                );
            }
        }
        pause;
    }}
    ||
    {loop {
        String rotary = Member4MachineStateV1.takeRotaryContext();
        if (rotary != null) {
            emit ROTARY_BOTTLE_CONTEXT(rotary);
        }
        String load = Member4MachineStateV1.takeLoadProfile();
        if (load != null) {
            emit LOAD_PROFILE(load);
        }
        String unload = Member4MachineStateV1.takeUnloadProfile();
        if (unload != null) {
            emit UNLOAD_PROFILE(unload);
        }
        String observation = Member4MachineStateV1.takeWorkpieceObservation();
        if (observation != null) {
            emit M4_WORKPIECE_OBSERVATION(observation);
        }
        pause;
    }}
}
