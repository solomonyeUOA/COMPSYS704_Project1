// Geometry-aware Capper with the frozen M1 status boundary.

CapperController(
    input signal CAPPER_STATUS_REQUEST;
    input String signal BOTTLE_AT_CAP;
    input String signal CAPPER_PLANT_FEEDBACK;

    output Integer signal CAPPER_STATUS;
    output String signal CAPPER_PLANT_COMMAND;
    output String signal MARK_CAPPED;
)
->{
    System.out.println("M4 CapperControllerCD started");

    {loop {
        present(CAPPER_STATUS_REQUEST) {
            emit CAPPER_STATUS(Member4MachineStateV1.getCapperStatus());
        }
        pause;
    }}
    ||
    {loop {
        present(BOTTLE_AT_CAP) {
            Member4MachineStateV1.acceptBottleAtCap(#BOTTLE_AT_CAP);
        }
        pause;
    }}
    ||
    {loop {
        present(CAPPER_PLANT_FEEDBACK) {
            Member4MachineStateV1.acceptCapperFeedback(
                #CAPPER_PLANT_FEEDBACK
            );
        }
        pause;
    }}
    ||
    {loop {
        Member4MachineStateV1.tick();
        String command = Member4MachineStateV1.takeCapperCommand();
        if (command != null) {
            emit CAPPER_PLANT_COMMAND(command);
        }
        String completed = Member4MachineStateV1.takeMarkCapped();
        if (completed != null) {
            emit MARK_CAPPED(completed);
        }
        pause;
    }}
}
