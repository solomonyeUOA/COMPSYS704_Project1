        <mxCell id="accept" value="CoordinatorStateV1.accept(receivedOrder)&#10;Parse + validate" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E8E1F5;strokeColor=#7253A3;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
