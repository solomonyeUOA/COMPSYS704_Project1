        <mxCell id="s4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#B18112;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontColor=#17212B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ctrl" target="store" value="Integer status replies">
          <mxGeometry relative="1" as="geometry" x="0" y="18" />
