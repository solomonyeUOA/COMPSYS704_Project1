        <mxCell id="s1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#6B7C8C;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontColor=#17212B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="timer" target="pause" value="NO">
