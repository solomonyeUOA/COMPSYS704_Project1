          <mxGeometry x="400" y="145" width="190" height="105" as="geometry" />
        </mxCell>
        <mxCell id="rejactive" value="Reject ORDER while active&#10;Return to wait state" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8D7DA;strokeColor=#B94A48;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
