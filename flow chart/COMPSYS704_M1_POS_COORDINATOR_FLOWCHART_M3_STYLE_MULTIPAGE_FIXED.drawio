        <mxCell id="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#7253A3;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontColor=#17212B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="req" target="ctrl" value="pure status requests">
          <mxGeometry relative="1" as="geometry" x="0" y="-18" />
