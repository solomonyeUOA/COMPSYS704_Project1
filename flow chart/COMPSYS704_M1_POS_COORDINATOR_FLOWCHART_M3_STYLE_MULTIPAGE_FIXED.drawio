        <mxCell id="title" value="Status Polling and Read-only Visualisation" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Eight independent Controller statuses are sampled approximately once per second and forwarded for observation" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#157A7E;" vertex="1" parent="1">
          <mxGeometry x="50" y="62" width="1500" height="28" as="geometry" />
        </mxCell>
        <mxCell id="timer" value="≈ 1 s polling deadline reached?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF0C2;strokeColor=#B18112;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="70" y="150" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pause" value="NO&#10;Pause / repeat" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E9EEF2;strokeColor=#6B7C8C;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="95" y="340" width="170" height="75" as="geometry" />
        </mxCell>
        <mxCell id="req" value="Emit eight pure requests&#10;LOADER / CONVEYOR / ROTARY&#10;FILLER_A / FILLER_B / LID&#10;CAPPER / UNLOADER&#10;*_STATUS_REQUEST" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E8E1F5;strokeColor=#7253A3;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="370" y="125" width="310" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ctrl" value="Machine Controllers&#10;Reply with current Integer status&#10;*_STATUS" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF0C2;strokeColor=#B18112;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="770" y="140" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="store" value="Coordinator listeners&#10;present(XXX_STATUS) → #XXX_STATUS&#10;Store latest state in CoordinatorStateV1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E8E1F5;strokeColor=#7253A3;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1160" y="125" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="forward" value="Forward machine state&#10;emit VIZ_XXX_STATUS(...)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E6F5F5;strokeColor=#157A7E;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1140" y="360" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="progress" value="Batch progress signals&#10;VIZ_REQUIRED_BOTTLES&#10;VIZ_COMPLETED_BOTTLES" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E6F5F5;strokeColor=#157A7E;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1140" y="510" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="vizcd" value="ABSVisualisationPlantCD&#10;Receives 10 Integer VIZ_* signals" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E6F5F5;strokeColor=#157A7E;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="720" y="430" width="310" height="110" as="geometry" />
        </mxCell>
        <mxCell id="gui" value="ABSVisualisation&#10;Symbolic machine states + batch progress&#10;Swing / Graphics2D" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E6F5F5;strokeColor=#157A7E;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="270" y="430" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="codes" value="Shared status convention&#10;0 = IDLE   1 = READY   2 = BUSY&#10;3 = DONE   4 = FAULT&#10;WAITING is a GUI-only initial state." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E9EEF2;strokeColor=#6B7C8C;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="430" y="680" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="pollnote" value="Polling is observational only.&#10;A *_STATUS_REQUEST must report current state and must not start or advance a physical operation." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E9EEF2;strokeColor=#6B7C8C;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
