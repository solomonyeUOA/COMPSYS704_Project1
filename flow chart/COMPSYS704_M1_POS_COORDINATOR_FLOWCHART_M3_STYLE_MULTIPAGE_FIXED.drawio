        <mxCell id="load" value="Load current product batch&#10;Product ID • quantity • A/B ratios" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E8E1F5;strokeColor=#7253A3;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1310" y="140" width="240" height="115" as="geometry" />
        </mxCell>
        <mxCell id="dispatch" value="Initial / next batch dispatch&#10;START_ORDER(requiredBottles)&#10;FILL_A_RATIO • FILL_B_RATIO" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF0C2;strokeColor=#B18112;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1">
