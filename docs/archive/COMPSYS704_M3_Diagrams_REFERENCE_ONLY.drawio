F1E4;strokeColor=#2B8053;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="230" height="120" as="geometry"/></mxCell><mxCell id="picking" value="PICKING&#xa;PICK_LID_TRIGGER" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DCECF7;strokeColor=#377EAB;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="420" y="330" width="250" height="120" as="geometry"/></mxCell><mxCell id="placing" value="PLACING&#xa;PLACE_LID_TRIGGER" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DCECF7;strokeColor=#377EAB;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="790" y="330" width="250" height="120" as="geometry"/></mxCell><mxCell id="ldone" value="DONE&#xa;Emit LID_CYCLE_DONE" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DDF1E4;strokeColor=#2B8053;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1190" y="190" width="250" height="120" as="geometry"/></mxCell><mxCell id="lfault" value="FAULT&#xa;Emit LID_ABORT" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8D7DA;strokeColor=#B94A48;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1190" y="520" width="250" height="120" as="geometry"/></mxCell><mxCell id="lsafety" value="Safety invariants&#xa;- Start only when a filled bottle is at P3&#xa;- Empty magazine enters FAULT&#xa;- Pick/place timeout de-energises actuators&#xa;- DONE is released only after lid state is recorded" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E9EEF2;strokeColor=#6B7C8C;strokeWidth=2;fontSize=15;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="350" y="700" width="730" height="135" as="geometry"/><