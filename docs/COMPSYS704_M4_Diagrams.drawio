          </mxGeometry>
        </mxCell>
        <mxCell id="f11" value="explicit reset after cause cleared" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#B94A48;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fault" target="fillB">
