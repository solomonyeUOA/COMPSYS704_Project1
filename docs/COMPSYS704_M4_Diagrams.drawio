        <mxCell id="f5" value="B target reached" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#2B8053;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="verify" target="bVerify">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f5b" value="total within tolerance; emit MARK_FILLED(id) → M3 Plant:12003" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#2B8053;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bVerify" target="done">
