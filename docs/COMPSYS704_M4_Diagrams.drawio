  <diagram id="dual-filler-fsm" name="2 Distributed Filler State Machines">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Distributed Dual-Liquid Filler State Machines" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="1500" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Separate Clock Domains, independent status values and an explicit bottleId-correlated handoff on receiver port 11005" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#157A7E;" vertex="1" parent="1">
          <mxGeometry x="50" y="62" width="1500" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="formula" value="Proposed M4 cross-CD contract&#10;BOTTLE_AT_FILL: String full BottleContext → Filler A&#10;FILL_A_DONE: String full BottleContext|measuredAMl → Filler B&#10;MARK_FILLED: String bottleId → M3 Plant:12003" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E8E1F5;strokeColor=#7253A3;strokeWidth=2;fontSize=13;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="95" width="510" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="laneA" value="FillerAControllerCD — receiver 11004" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#377EAB;" vertex="1" parent="1">
          <mxGeometry x="60" y="105" width="600" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="laneB" value="FillerBControllerCD — receiver 11005" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#B18112;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="600" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="wait" value="A_WAIT_RECIPE&#10;Status 0 / valves OFF&#10;Store Integer ratioA" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E9EEF2;strokeColor=#6B7C8C;strokeWidth=2;fontSize=14;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="190" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="ready" value="A_READY&#10;Status 1&#10;Latch new bottleId/context&#10;Ignore completed duplicate" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DDF1E4;strokeColor=#2B8053;strokeWidth=2;fontSize=14;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="370" y="190" width="230" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="fillA" value="A_FILL&#10;Status 2&#10;Dose to targetA&#10;Tolerance + shutoff lead" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DCECF7;strokeColor=#377EAB;strokeWidth=2;fontSize=14;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="190" width="230" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="aDone" value="A_DONE&#10;Status 3 / record completed id&#10;Forward unchanged size + capacity&#10;Emit FILL_A_DONE(id|size|capacity|measuredA)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DDF1E4;strokeColor=#2B8053;strokeWidth=2;fontSize=12;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="970" y="190" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="aFault" value="A_FAULT&#10;Status 4&#10;Valve OFF&#10;No completion" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8D7DA;strokeColor=#B94A48;strokeWidth=2;fontSize=14;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1310" y="230" width="210" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="fillB" value="B_WAIT_A&#10;Status 0 until ratioB valid; then 1&#10;Wait FILL_A_DONE&#10;Latch matching id + size + capacity" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF0C2;strokeColor=#B18112;strokeWidth=2;fontSize=13;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="verify" value="B_FILL&#10;Status 2&#10;Dose to targetB&#10;Monitor total volume" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DCECF7;strokeColor=#377EAB;strokeWidth=2;fontSize=14;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="410" y="500" width="230" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="bVerify" value="B_VERIFY&#10;Matching bottleId&#10;Total within tolerance&#10;No overflow" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF0C2;strokeColor=#B18112;strokeWidth=2;fontSize=14;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="720" y="500" width="230" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="done" value="B_DONE&#10;Status 3&#10;Record lastCompletedBottleId&#10;Emit MARK_FILLED(id) once" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DDF1E4;strokeColor=#2B8053;strokeWidth=2;fontSize=13;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="500" width="270" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="fault" value="B_FAULT&#10;Status 4&#10;Valve OFF&#10;No MARK_FILLED" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8D7DA;strokeColor=#B94A48;strokeWidth=2;fontSize=14;fontColor=#17212B;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1330" y="530" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="safety" value="Shared safety / idempotence rules&#10;- Status polling only returns each CD's current 0..4 status and never advances state&#10;- activeBottleId must match every context and completion payload; stale/mismatched events are ignored or faulted&#10;- Duplicate completed bottleId never reopens a valve and may only re-send the recorded completion&#10;- closeThreshold = target - shutoffLeadMl; accept when |measured-target| ≤ toleranceMl&#10;- Any timeout, sensor conflict or measuredTotal &gt; capacityMl + overflowMarginMl de-energises the owning filler" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E9EEF2;strokeColor=#6B7C8C;strokeWidth=2;fontSize=13;fontColor=#17212B;align=left;spacingLeft=12;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="700" width="1000" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="valid ratioA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#2B8053;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="wait" target="ready">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="new BOTTLE_AT_FILL(full BottleContext)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#2B8053;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ready" target="fillA">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="A within tolerance" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#377EAB;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fillA" target="aDone">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f3x" value="FILL_A_DONE(String id|size|capacity|measuredA) → 11005" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;dashed=1;strokeColor=#B18112;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="aDone" target="fillB">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
