<?xml version="1.0" encoding="UTF-8"?>
<System xmlns="http://systemjtechnology.com">
    <SubSystem Name="COORDINATOR_SS" Local="true">
        <ClockDomain Name="CoordinatorCD" Class="Coordinator">
            <!-- POS -> Coordinator and Controller -> Coordinator inputs -->
            <iSignal Name="ORDER" Class="com.systemj.ipc.SimpleServer"
                     IP="127.0.0.1" Port="11001" />
            <iSignal Name="LOADER_STATUS" Class="com.systemj.ipc.SimpleServer"
                     IP="127.0.0.1" Port="11001" />
            <iSignal Name="CONVEYOR_STATUS" Class="com.systemj.ipc.SimpleServer"
                     IP="127.0.0.1" Port="11001" />
            <iSignal Name="ROTARY_STATUS" Class="com.systemj.ipc.SimpleServer"
                     IP="127.0.0.1" Port="11001" />
            <iSignal Name="FILLER_A_STATUS" Class="com.systemj.ipc.SimpleServer"
                     IP="127.0.0.1" Port="11001" />
            <iSignal Name="FILLER_B_STATUS" Class="com.systemj.ipc.SimpleServer"
                     IP="127.0.0.1" Port="11001" />
            <iSignal Name="LID_STATUS" Class="com.systemj.ipc.SimpleServer"
                     IP="127.0.0.1" Port="11001" />
            <iSignal Name="CAPPER_STATUS" Class="com.systemj.ipc.SimpleServer"
                     IP="127.0.0.1" Port="11001" />
            <iSignal Name="UNLOADER_STATUS" Class="com.systemj.ipc.SimpleServer"
                     IP="127.0.0.1" Port="11001" />
            <iSignal Name="BOTTLE_DONE" Class="com.systemj.ipc.SimpleServer"
                     IP="127.0.0.1" Port="11001" />

            <!-- M3 FaultSupervisorCD -> CoordinatorCD, frozen V2.1 -->
            <iSignal Name="FT_FAULT_ALERT"
                     Class="com.systemj.ipc.SimpleServer"
                     IP="127.0.0.1" Port="11001" />
            <iSignal Name="FT_SAFE_STOP_REQUEST"
                     Class="com.systemj.ipc.SimpleServer"
                     IP="127.0.0.1" Port="11001" />
            <iSignal Name="FT_RECOVERY_READY"
                     Class="com.systemj.ipc.SimpleServer"
                     IP="127.0.0.1" Port="11001" />
            <iSignal Name="FT_RECOVERY_FAILED"
                     Class="com.systemj.ipc.SimpleServer"
                     IP="127.0.0.1" Port="11001" />

            <!-- Coordinator -> POS -->
            <oSignal Name="ORDER_COMPLETE" To="POSCD.ORDER_COMPLETE"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11000" />

            <!-- CoordinatorCD -> M3 FaultSupervisorCD, frozen V2.1 -->
            <oSignal Name="FT_SAFE_STOP_ACK"
                     To="FaultSupervisorCD.FT_SAFE_STOP_ACK"
                     Class="OptionalSimpleClient"
                     IP="127.0.0.1" Port="13003" />
            <oSignal Name="FT_RESUME_DECISION"
                     To="FaultSupervisorCD.FT_RESUME_DECISION"
                     Class="OptionalSimpleClient"
                     IP="127.0.0.1" Port="13003" />

            <!-- Coordinator -> Bottle Loader Controller -->
            <oSignal Name="START_ORDER"
                     To="BottleLoaderControllerCD.START_ORDER"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11002" />
            <oSignal Name="LOADER_STATUS_REQUEST"
                     To="BottleLoaderControllerCD.LOADER_STATUS_REQUEST"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11002" />

            <!-- Coordinator -> M2 Conveyor Controller (assigned receiver). -->
            <oSignal Name="CONVEYOR_STATUS_REQUEST"
                     To="ConveyorControllerCD.CONVEYOR_STATUS_REQUEST"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11009" />

            <!-- Coordinator -> M3 Rotary Table Controller, frozen V2.1. -->
            <oSignal Name="ROTARY_STATUS_REQUEST"
                     To="RotaryTableControllerCD.ROTARY_STATUS_REQUEST"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11003" />

            <!-- Coordinator -> Filler A Controller -->
            <oSignal Name="FILL_A_RATIO"
                     To="FillerAControllerCD.FILL_A_RATIO"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11004" />
            <oSignal Name="FILLER_A_STATUS_REQUEST"
                     To="FillerAControllerCD.FILLER_A_STATUS_REQUEST"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11004" />

            <!-- Coordinator -> Filler B Controller -->
            <oSignal Name="FILL_B_RATIO"
                     To="FillerBControllerCD.FILL_B_RATIO"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11005" />
            <oSignal Name="FILLER_B_STATUS_REQUEST"
                     To="FillerBControllerCD.FILLER_B_STATUS_REQUEST"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11005" />

            <!-- Coordinator -> Lid Loader Controller -->
            <oSignal Name="LID_STATUS_REQUEST"
                     To="LidLoaderControllerCD.LID_STATUS_REQUEST"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11006" />

            <!-- Coordinator -> Capper Controller -->
            <oSignal Name="CAPPER_STATUS_REQUEST"
                     To="CapperControllerCD.CAPPER_STATUS_REQUEST"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11007" />

            <!-- Coordinator -> Bottle Unloader Controller -->
            <oSignal Name="UNLOADER_STATUS_REQUEST"
                     To="BottleUnloaderControllerCD.UNLOADER_STATUS_REQUEST"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11010" />

            <!-- Coordinator -> Overall ABS Visualisation Plant -->
            <oSignal Name="VIZ_LOADER_STATUS"
                     To="ABSVisualisationPlantCD.VIZ_LOADER_STATUS"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11008" />
            <oSignal Name="VIZ_CONVEYOR_STATUS"
                     To="ABSVisualisationPlantCD.VIZ_CONVEYOR_STATUS"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11008" />
            <oSignal Name="VIZ_ROTARY_STATUS"
                     To="ABSVisualisationPlantCD.VIZ_ROTARY_STATUS"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11008" />
            <oSignal Name="VIZ_FILLER_A_STATUS"
                     To="ABSVisualisationPlantCD.VIZ_FILLER_A_STATUS"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11008" />
            <oSignal Name="VIZ_FILLER_B_STATUS"
                     To="ABSVisualisationPlantCD.VIZ_FILLER_B_STATUS"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11008" />
            <oSignal Name="VIZ_LID_STATUS"
                     To="ABSVisualisationPlantCD.VIZ_LID_STATUS"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11008" />
            <oSignal Name="VIZ_CAPPER_STATUS"
                     To="ABSVisualisationPlantCD.VIZ_CAPPER_STATUS"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11008" />
            <oSignal Name="VIZ_UNLOADER_STATUS"
                     To="ABSVisualisationPlantCD.VIZ_UNLOADER_STATUS"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11008" />
            <oSignal Name="VIZ_REQUIRED_BOTTLES"
                     To="ABSVisualisationPlantCD.VIZ_REQUIRED_BOTTLES"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11008" />
            <oSignal Name="VIZ_COMPLETED_BOTTLES"
                     To="ABSVisualisationPlantCD.VIZ_COMPLETED_BOTTLES"
                     Class="com.systemj.ipc.SimpleClient"
                     IP="127.0.0.1" Port="11008" />
        </ClockDomain>
    </SubSystem>
</System>
