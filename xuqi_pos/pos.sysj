// COMPSYS704 Project 1 - POS size-aware integration with Swing visualisation
//
// ORDER V2:          orderId|productCount|productId,sizeCode,A%,B%,quantity;...
// ORDER_COMPLETE V1: orderId|COMPLETED|completionTimeSeconds
// RESET:             RSTnnnn / RSTnnnn|RESET_COMPLETE

POS(
    input String signal ORDER_COMPLETE;
    input String signal SYSTEM_RESET_COMPLETE;
    output String signal ORDER;
    output String signal SYSTEM_RESET_REQUEST;
)
->{
    POSVisualisation.start();
    System.out.println("POS Integration V1 started");

    loop {
        String submittedOrder = POSVisualisation.pollSubmittedOrder();
        if (submittedOrder != null) {
            // POS validates again at the SystemJ boundary. The Coordinator
            // performs its own independent validation after receiving ORDER.
            if (OrderV2.parse(submittedOrder) != null ||
                OrderV1.parse(submittedOrder) != null) {
                emit ORDER(submittedOrder);
                if (POSVisualisation.isOrderTransmissionStart()) {
                    POSVisualisation.showSubmitted(submittedOrder);
                    System.out.println(
                        "POS sent ORDER: " + submittedOrder
                    );
                }
            }
            else {
                POSVisualisation.showValidationError(
                    "Invalid order was not sent"
                );
                System.out.println(
                    "POS rejected invalid order: " + submittedOrder
                );
            }
        }

        String resetRequest = POSVisualisation.pollSystemResetRequest();
        if (resetRequest != null) {
            emit SYSTEM_RESET_REQUEST(resetRequest);
            if (POSVisualisation.isSystemResetTransmissionStart()) {
                System.out.println(
                    "POS sent SYSTEM_RESET_REQUEST: " + resetRequest
                );
            }
        }

        present(ORDER_COMPLETE) {
            String completionResult =
                POSVisualisation.handleCompletion(#ORDER_COMPLETE);
            if (completionResult != null) {
                System.out.println(completionResult);
            }
        }


        present(SYSTEM_RESET_COMPLETE) {
            String resetResult = POSVisualisation.handleSystemResetComplete(
                #SYSTEM_RESET_COMPLETE
            );
            if (resetResult != null) {
                System.out.println(resetResult);
            }
        }

        pause;
    }
}
