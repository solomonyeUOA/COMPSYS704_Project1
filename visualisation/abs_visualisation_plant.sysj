// Overall ABS Visualisation Plant.
//
// This Clock Domain displays Coordinator-aggregated state only. It never
// connects to Machine Controllers and it does not control a physical Plant.

ABSVisualisationPlant(
    input Integer signal VIZ_LOADER_STATUS;
    input Integer signal VIZ_TRANSPORT_STATUS;
    input Integer signal VIZ_FILLER_A_STATUS;
    input Integer signal VIZ_FILLER_B_STATUS;
    input Integer signal VIZ_LID_STATUS;
    input Integer signal VIZ_CAPPER_STATUS;
    input Integer signal VIZ_REQUIRED_BOTTLES;
    input Integer signal VIZ_COMPLETED_BOTTLES;
)
->{
    ABSVisualisation.start();
    System.out.println("ABSVisualisationPlantCD started");

    {loop {present(VIZ_LOADER_STATUS) {
        ABSVisualisation.updateStatus(
            "Bottle Loader", #VIZ_LOADER_STATUS
        );
    } pause;}}
    ||
    {loop {present(VIZ_TRANSPORT_STATUS) {
        ABSVisualisation.updateStatus(
            "Transport", #VIZ_TRANSPORT_STATUS
        );
    } pause;}}
    ||
    {loop {present(VIZ_FILLER_A_STATUS) {
        ABSVisualisation.updateStatus(
            "Filler A", #VIZ_FILLER_A_STATUS
        );
    } pause;}}
    ||
    {loop {present(VIZ_FILLER_B_STATUS) {
        ABSVisualisation.updateStatus(
            "Filler B", #VIZ_FILLER_B_STATUS
        );
    } pause;}}
    ||
    {loop {present(VIZ_LID_STATUS) {
        ABSVisualisation.updateStatus(
            "Lid Loader", #VIZ_LID_STATUS
        );
    } pause;}}
    ||
    {loop {present(VIZ_CAPPER_STATUS) {
        ABSVisualisation.updateStatus(
            "Capper", #VIZ_CAPPER_STATUS
        );
    } pause;}}
    ||
    {loop {present(VIZ_REQUIRED_BOTTLES) {
        ABSVisualisation.updateRequiredBottles(
            #VIZ_REQUIRED_BOTTLES
        );
    } pause;}}
    ||
    {loop {present(VIZ_COMPLETED_BOTTLES) {
        ABSVisualisation.updateCompletedBottles(
            #VIZ_COMPLETED_BOTTLES
        );
    } pause;}}
}
