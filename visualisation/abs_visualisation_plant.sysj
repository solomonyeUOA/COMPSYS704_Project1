// Overall ABS Visualisation Plant.
//
// This Clock Domain displays read-only state. Statuses come through the
// Coordinator; optional IP telemetry may arrive directly from a Controller.
// It never emits a machine command or controls a physical Plant.

ABSVisualisationPlant(
    input Integer signal VIZ_LOADER_STATUS;
    input Integer signal VIZ_CONVEYOR_STATUS;
    input Integer signal VIZ_ROTARY_STATUS;
    input Integer signal VIZ_FILLER_A_STATUS;
    input Integer signal VIZ_FILLER_B_STATUS;
    input Integer signal VIZ_LID_STATUS;
    input Integer signal VIZ_CAPPER_STATUS;
    input Integer signal VIZ_UNLOADER_STATUS;
    input Integer signal VIZ_REQUIRED_BOTTLES;
    input Integer signal VIZ_COMPLETED_BOTTLES;
    // Optional M1 IP-only projection of Coordinator-observed M3 evidence.
    input String signal VIZ_FT_EVIDENCE;
    input String signal VIZ_SYSTEM_RESET;
    input Integer signal VIZ_LABELLER_STATUS;
    input Integer signal VIZ_SORT_PACK_STATUS;
    input String signal VIZ_TWIN_SNAPSHOT;
    input String signal M4_CAPPER_STATE;
)
->{
    ABSVisualisation.start();
    System.out.println("ABSVisualisationPlantCD started");

    {loop {present(VIZ_LOADER_STATUS) {
        ABSVisualisation.updateStatus(
            "Bottle Loader", #VIZ_LOADER_STATUS
        );
    } pause;}}
    ||
    {loop {present(VIZ_CONVEYOR_STATUS) {
        ABSVisualisation.updateStatus(
            "Conveyor", #VIZ_CONVEYOR_STATUS
        );
    } pause;}}
    ||
    {loop {present(VIZ_ROTARY_STATUS) {
        ABSVisualisation.updateStatus(
            "Rotary Turntable", #VIZ_ROTARY_STATUS
        );
    } pause;}}
    ||
    {loop {present(VIZ_FILLER_A_STATUS) {
        ABSVisualisation.updateStatus(
            "Filler A", #VIZ_FILLER_A_STATUS
        );
    } pause;}}
    ||
    {loop {present(VIZ_FILLER_B_STATUS) {
        ABSVisualisation.updateStatus(
            "Filler B", #VIZ_FILLER_B_STATUS
        );
    } pause;}}
    ||
    {loop {present(VIZ_LID_STATUS) {
        ABSVisualisation.updateStatus(
            "Lid Loader", #VIZ_LID_STATUS
        );
    } pause;}}
    ||
    {loop {present(VIZ_CAPPER_STATUS) {
        ABSVisualisation.updateStatus(
            "Capper", #VIZ_CAPPER_STATUS
        );
    } pause;}}
    ||
    {loop {present(VIZ_UNLOADER_STATUS) {
        ABSVisualisation.updateStatus(
            "Bottle Unloader", #VIZ_UNLOADER_STATUS
        );
    } pause;}}
    ||
    {loop {present(VIZ_REQUIRED_BOTTLES) {
        ABSVisualisation.updateRequiredBottles(
            #VIZ_REQUIRED_BOTTLES
        );
    } pause;}}
    ||
    {loop {present(VIZ_COMPLETED_BOTTLES) {
        ABSVisualisation.updateCompletedBottles(
            #VIZ_COMPLETED_BOTTLES
        );
    } pause;}}
    ||
    {loop {present(VIZ_FT_EVIDENCE) {
        ABSVisualisation.updateFtEvidence(#VIZ_FT_EVIDENCE);
    } pause;}}
    ||
    {loop {present(VIZ_SYSTEM_RESET) {
        ABSVisualisation.resetSystem(#VIZ_SYSTEM_RESET);
    } pause;}}
    ||
    {loop {present(VIZ_LABELLER_STATUS) {
        ABSVisualisation.updateLabellerStatus(#VIZ_LABELLER_STATUS);
    } pause;}}
    ||
    {loop {present(VIZ_SORT_PACK_STATUS) {
        ABSVisualisation.updateStatus("Sort / Pack", #VIZ_SORT_PACK_STATUS);
    } pause;}}
    ||
    {loop {present(VIZ_TWIN_SNAPSHOT) {
        ABSVisualisation.updateTwinSnapshot(#VIZ_TWIN_SNAPSHOT);
    } pause;}}
    ||
    {loop {present(M4_CAPPER_STATE) {
        ABSVisualisation.updateM4CapperState(#M4_CAPPER_STATE);
    } pause;}}
}
